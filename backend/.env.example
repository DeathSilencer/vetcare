# ============================================================================
# VetCare — Plantilla de Variables de Entorno del Backend
# Copia este archivo como .env en la carpeta backend/
# ============================================================================

PORT=4000
NODE_ENV=development

# Conexión MySQL / MariaDB (XAMPP por defecto: usuario root, sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vetcare
DB_SSL=false

# Clave secreta para la firma de sesiones HTTP-only
SESSION_SECRET=vetcare_ultra_secure_session_key_academic_2026_xyz!
COOKIE_NAME=vetcare_sid
CLIENT_URL=http://localhost:5173

# Credenciales del Administrador por Defecto
DEFAULT_ADMIN_NAME="Administrador VetCare"
DEFAULT_ADMIN_EMAIL="admin@vetcare.com"
DEFAULT_ADMIN_PASSWORD="Admin123!"
